        function handleMainAction() {
            if (isWatching) {
                if (window.AndroidBridge && window.AndroidBridge.stopAutoWatch) {
                    window.AndroidBridge.stopAutoWatch();
                } else {
                    fetch('index.php?api=stop_watching&user_id=' + USER_ID);
                }
                updateWatchState(false, 0);
            } else {
                if (window.AndroidBridge && window.AndroidBridge.launchAutoWatch) {
                    window.AndroidBridge.launchAutoWatch(USER_ID);
                } else {
                    fetch('index.php?api=get_video&user_id=' + USER_ID)
                        .then(r => r.json())
                        .then(d => {
                            if (d.status === 'success') {
                                window.location.href = "vnd.youtube:" + d.video_id;
                                updateWatchState(true, d.duration || 15);
                            } else {
                                alert(d.message || "No task available right now");
                            }
                        });
                }
            }
        }

        function updateWatchState(running, secRemaining) {
            isWatching = running;
            const btn = document.getElementById('btn-action-main');
            const timerBox = document.getElementById('inapp-timer-box');
            const secText = document.getElementById('inapp-sec');

            if (running) {
