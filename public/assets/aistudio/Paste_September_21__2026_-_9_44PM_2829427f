        function calcCost() {
            const v = parseInt(document.getElementById('pviews').value || 10);
            const d = parseInt(document.getElementById('pduration').value || 15);
            let unitCost = COST_15;
            if (d >= 60) unitCost = COST_60;
            else if (d >= 30) unitCost = COST_30;

            document.getElementById('pcost').innerText = '$' + (v * unitCost).toFixed(4);
        }

