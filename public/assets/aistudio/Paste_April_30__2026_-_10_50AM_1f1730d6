    text = (
        f"📝 <b>Register account using data:</b>\n\n"
        f"📧 Email: <code>{gmail}</code>\n"
        f"🔑 Password: <code>{pwd}</code>\n\n"
        f"⏱ Auto-cancel at: {expiry.strftime('%I:%M %p')}"
    )

    kb = InlineKeyboardBuilder()
    kb.row(InlineKeyboardButton(text="Done ✅", callback_data=f"done_t:{gmail}"),
           InlineKeyboardButton(text="Cancel Task ❌", callback_data=f"canc_t:{sid}:{gmail}"))
    kb.row(InlineKeyboardButton(text="Copy Email 📧", callback_data=f"copy_v:{gmail}"),
           InlineKeyboardButton(text="Copy Password 🔑", callback_data=f"copy_v:{pwd}"))
    
    msg = await message.answer(text, reply_markup=kb.as_markup(), parse_mode="HTML")

    await asyncio.sleep(900)
    db.execute("SELECT status FROM tasks WHERE gmail=? AND status='in_progress'", (gmail,))
    if db.fetchone():
        db.execute("DELETE FROM tasks WHERE gmail=? AND uid=?", (gmail, uid))
        db.execute("UPDATE stock SET status='available' WHERE sid=?", (sid,))
        conn.commit()
        try: await msg.delete()
        except: pass
        await bot.send_message(uid, "⏰ <b>time out task Chanel</b>")

