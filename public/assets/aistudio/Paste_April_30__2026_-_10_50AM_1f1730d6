@dp.callback_query(F.data.startswith("adm_t_app:"))
async def admin_task_approve_final(call: CallbackQuery):
    """ٹاسک اپروو کرنے کا فکسڈ فنکشن (Error Fixed)"""
    tid = int(call.data.split(":")[1])
    
    db.execute("SELECT uid, status FROM tasks WHERE tid=?", (tid,))
