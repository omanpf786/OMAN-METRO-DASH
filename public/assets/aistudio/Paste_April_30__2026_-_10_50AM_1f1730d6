@dp.message(CommandStart())
async def start_handler(message: Message, state: FSMContext):
    await state.clear()
    uid = message.from_user.id
    if not await is_subscribed(uid):
        kb = InlineKeyboardBuilder()
        kb.row(InlineKeyboardButton(text="📢 Join Official Channel", url=CHANNEL_LINK))
        kb.row(InlineKeyboardButton(text="🔄 Verify Membership", callback_data="v_sub"))
        await message.answer("👋 <b>Welcome!</b>\nYou must join our channel first.", reply_markup=kb.as_markup(), parse_mode="HTML")
        return

    db.execute("SELECT uid FROM users WHERE uid=?", (uid,))
    if not db.fetchone():
        db.execute("INSERT INTO users (uid, joined_date) VALUES (?, ?)", (uid, str(datetime.datetime.now(karachi_tz).strftime("%Y-%m-%d"))))
        conn.commit()

    if is_admin(uid):
        await message.answer("🛠️ <b>ADMIN MODE ACTIVATED</b>", reply_markup=get_admin_menu(), parse_mode="HTML")
    else:
        await message.answer("👋 <b>Welcome to Gmail Ultra Pro Bot!</b>", reply_markup=get_user_menu(), parse_mode="HTML")

@dp.callback_query(F.data == "v_sub")
async def verify_sub(call: CallbackQuery, state: FSMContext):
    if await is_subscribed(call.from_user.id):
        await call.message.delete()
        await start_handler(call.message, state)
    else:
        await call.answer("❌ Join first!", show_alert=True)

