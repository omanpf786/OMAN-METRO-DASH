        "━━━━━━━━━━━━━━━━━━\n"
        "Please fix the issue and submit again."
    )
    try: await bot.send_message(uid, rej_msg, parse_mode="HTML")
    except: pass
    
    await call.message.delete()
    await call.answer("Task Rejected ❌")

