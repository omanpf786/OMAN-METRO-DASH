@dp.message(AdminStates.history_id)
async def admin_history_view(message: Message, state: FSMContext):
    uid = message.text.strip()
    rew = get_conf('reward')
    
    # یوزر کے بیلنس اور سٹیٹس چیک کریں
    db.execute("SELECT total_earned, total_withdrawn, balance FROM users WHERE uid=?", (uid,))
    user_stats = db.fetchone()
    
    if not user_stats:
        await message.answer(f"❌ <b>Error:</b> User ID <code>{uid}</code> not found in database.", parse_mode="HTML")
        await state.clear()
        return

    # 1. پینڈنگ ٹاسک نکالنا
    db.execute("SELECT gmail, password FROM tasks WHERE uid=? AND status='pending'", (uid,))
    pending_tasks = db.fetchall()
    
    # 2. اپرووڈ ٹاسک نکالنا
    db.execute("SELECT gmail, password FROM tasks WHERE uid=? AND status='approved'", (uid,))
    approved_tasks = db.fetchall()

    # 3. ریجیکٹڈ ٹاسک نکالنا (نیا اضافہ)
    db.execute("SELECT gmail, password FROM tasks WHERE uid=? AND status='rejected'", (uid,))
    rejected_tasks = db.fetchall()
    
    # --- میسج کی ڈیزائننگ شروع ---
    output = f"📋 <b>COMPLETE HISTORY FOR:</b> <code>{uid}</code>\n"
    output += "━━━━━━━━━━━━━━━━━━\n\n"
    
    # ⏳ PENDING SECTION
    output += "⏳ <b><u>PENDING GMAIL</u></b>\n"
    output += "<i>Gmail | Reward | Password</i>\n"
    if pending_tasks:
        for pt in pending_tasks:
            output += f"📧 <code>{pt[0]}</code> | ${rew} | 🔑 <code>{pt[1]}</code>\n"
    else:
        output += "<i>(No Pending Tasks)</i>\n"
        
    # ✅ APPROVED SECTION
    output += "\n✅ <b><u>APPROVED GMAIL</u></b>\n"
    output += "<i>Gmail | Reward | Password</i>\n"
    if approved_tasks:
        for at in approved_tasks:
            output += f"📧 <code>{at[0]}</code> | ${rew} | 🔑 <code>{at[1]}</code>\n"
    else:
        output += "<i>(No Approved Tasks)</i>\n"

    # ❌ REJECTED SECTION
    output += "\n❌ <b><u>REJECTED GMAIL</u></b>\n"
    output += "<i>Gmail | Reward | Password</i>\n"
    if rejected_tasks:
        for rt in rejected_tasks:
            output += f"📧 <code>{rt[0]}</code> | ${rew} | 🔑 <code>{rt[1]}</code>\n"
    else:
        output += "<i>(No Rejected Tasks)</i>\n"
        
    # 💰 SUMMARY SECTION
    output += "\n━━━━━━━━━━━━━━━━━━\n"
    output += f"💵 <b>Current Balance:</b> ${user_stats[2]:.2f}\n"
    output += f"🏆 <b>Total Earnings:</b> ${user_stats[0]:.2f}\n"
    output += f"💸 <b>Total Withdrawn:</b> ${user_stats[1]:.2f}"
    
    # میسج بہت لمبا ہو سکتا ہے اس لیے اسے محفوظ طریقے سے بھیجنا
    try:
        await message.answer(output, parse_mode="HTML")
    except Exception as e:
        await message.answer("⚠️ History is too long to display in one message.")
        
    await state.clear()
