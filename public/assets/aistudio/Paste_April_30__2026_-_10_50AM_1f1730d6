@dp.callback_query(F.data.startswith("adm_t_finrej:"))
async def admin_task_reject_final(call: CallbackQuery):
    """ٹاسک ریجیکٹ کرنے کا حتمی عمل"""
    _, tid, code = call.data.split(":")
    
    db.execute("SELECT uid, gmail, password FROM tasks WHERE tid=?", (tid,))
    t_data = db.fetchone()
    if not t_data: return
    
    uid = t_data[0]
    reason = {"WPass": "Wrong Password", "Limit": "Device Removal Required", "Used": "Already Used Account", "Robot": "Robot Verification Required"}.get(code, "Unknown")
    
    db.execute("UPDATE tasks SET status='rejected' WHERE tid=?", (tid,))
    db.execute("UPDATE users SET rejected = rejected + 1 WHERE uid=?", (uid,))
    conn.commit()
    
    rej_msg = (
        "❌ <b>TASK REJECTED!</b>\n"
        f"Reason: <i>{reason}</i>\n"
        "━━━━━━━━━━━━━━━━━━\n"
        f"📧 Gmail: <code>{t_data[1]}</code>\n"
