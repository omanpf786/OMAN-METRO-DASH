@dp.message(AdminStates.txid_input)
async def admin_pay_confirm(message: Message, state: FSMContext):
    """ودڈرا کامیاب کرنا - فکسڈ ورژن"""
    txid = message.text.strip()
    data = await state.get_data()
    wid = data.get('active_wid')
    
    if not wid:
        await message.answer("❌ Error: Withdrawal ID not found in session.")
        await state.clear()
        return

    try:
        # چیک کریں کہ ودڈرا موجود ہے یا نہیں
        db.execute("SELECT uid, amount, net FROM withdraws WHERE wid=?", (wid,))
        w_info = db.fetchone()
        
        if not w_info:
            await message.answer("❌ Error: Withdrawal record not found in database.")
            return
        
        uid, amt, net = w_info[0], w_info[1], w_info[2]
        
        # ڈیٹا بیس اپڈیٹ (یہاں غلطی تھی جو اب ٹھیک کر دی گئی ہے)
        db.execute("UPDATE withdraws SET status='success', txid=? WHERE wid=?", (txid, wid))
        db.execute("UPDATE users SET balance = balance - ?, total_withdrawn = total_withdrawn + ? WHERE uid=?", (amt, amt, uid))
        conn.commit()
        
        user_alert = (
            "✅ <b>WITHDRAWAL SUCCESSFUL!</b>\n\n"
            f"💰 Net Amount: <b>${net:.4f}</b>\n"
            f"⛓ TxID: <code>{txid}</code>\n\n"
            "<i>Thank you for working with us!</i>"
        )
        
        try: 
            await bot.send_message(uid, user_alert, parse_mode="HTML")
        except: 
            pass
        
        await message.answer(f"✅ Withdrawal Approved!\nUser ID: {uid}\nTxID: {txid}")
        await state.clear()

    except Exception as e:
        await message.answer(f"⚠️ Database Error: {str(e)}")
        print(f"Error in admin_pay_confirm: {e}")
