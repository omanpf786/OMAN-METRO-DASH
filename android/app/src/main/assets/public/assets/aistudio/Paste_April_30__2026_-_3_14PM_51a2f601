@dp.message(UserStates.wd_amount)
async def withdraw_final_logic(message: Message, state: FSMContext):
    try:
        amt = float(message.text)
        min_w = float(get_conf('min_withdraw'))
        db.execute("SELECT balance FROM users WHERE uid=?", (message.from_user.id,))
        bal = db.fetchone()[0]
        
        if amt < min_w or amt > bal:
            await message.answer(f"❌ <b>Invalid!</b> Min: ${min_w} | Max: ${bal}")
