async def admin_addfile_final(message: Message, state: FSMContext):
    file = await bot.get_file(message.document.file_id)
    content = await bot.download_file(file.file_path)
    lines = content.read().decode('utf-8').splitlines()
    count = 0
    for line in lines:
        if ":" in line:
            e, p = line.split(":", 1)
            db.execute("INSERT INTO stock (gmail, password) VALUES (?, ?)", (e.strip(), p.strip()))
            count += 1
    conn.commit()
    await message.answer(f"✅ Added <b>{count}</b> tasks to stock!")
    await state.clear()

