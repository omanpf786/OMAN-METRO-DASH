@dp.callback_query(F.data.startswith("f_dn:"))
async def done_task_user(call: CallbackQuery):
    gmail = call.data.split(":")[1]
    db.execute("SELECT start_ts FROM tasks WHERE gmail=? AND uid=? AND status='in_progress'", (gmail, call.from_user.id))
    res = db.fetchone()
    if not res: return
    
    elapsed = datetime.datetime.now().timestamp() - res[0]
    if elapsed < 200:
        await call.answer(f"🛡️ Security: Wait {int(200-elapsed)} more seconds.", show_alert=True)
    else:
        now = datetime.datetime.now(karachi_tz)
        db.execute("UPDATE tasks SET status='pending', date=?, time=? WHERE gmail=?", 
                   (now.strftime("%d/%m/%Y"), now.strftime("%I:%M %p"), gmail))
        db.execute("SELECT tid FROM tasks WHERE gmail=?", (gmail,))
        tid = db.fetchone()[0]
        conn.commit()
        
        success_msg = (
