@dp.message(F.text == "📝 Register Task")
async def register_task_user(message: Message, state: FSMContext):
    await state.clear()
    uid = message.from_user.id
    if get_conf('order_status') == "OFF":
        await message.answer("🛑 <b>Maintenance Mode:</b> Orders are stopped.", parse_mode="HTML")
        return

    db.execute("SELECT tid FROM tasks WHERE uid=? AND status='in_progress'", (uid,))
    if db.fetchone():
        await message.answer("⚠️ <b>You already have an active task!</b>\nComplete or cancel it first.", parse_mode="HTML")
        return

    db.execute("SELECT sid, gmail, password FROM stock WHERE status='available' LIMIT 1")
    acc = db.fetchone()
    if not acc:
        await message.answer("❌ <b>No tasks available!</b>\nPlease wait for the admin to add more stock.", parse_mode="HTML")
        return

    sid, gmail, pwd = acc
    now = datetime.datetime.now(karachi_tz)
    expiry = now + datetime.timedelta(minutes=15)
    start_ts = now.timestamp()
    
    db.execute("UPDATE stock SET status='reserved' WHERE sid=?", (sid,))
    db.execute("INSERT INTO tasks (uid, gmail, password, status, start_ts) VALUES (?, ?, ?, 'in_progress', ?)",
               (uid, gmail, pwd, start_ts))
    conn.commit()

    text = (
        f"📝 <b>Task Instructions:</b>\n\n"
        f"📧 Email: <code>{gmail}</code>\n"
        f"🔑 Password: <code>{pwd}</code>\n\n"
        f"⏱ Auto-cancel at: {expiry.strftime('%I:%M %p')}\n\n"
        "<i>Tap the email or password to copy instantly! Click Done after registration.</i>"
    )

    kb = InlineKeyboardBuilder()
    kb.row(InlineKeyboardButton(text="Done ✅", callback_data=f"f_dn:{gmail}"),
           InlineKeyboardButton(text="Cancel Task ❌", callback_data=f"f_cn:{sid}:{gmail}"))
    kb.row(InlineKeyboardButton(text="Copy Email 📧", callback_data=f"f_cp:{gmail}"),
           InlineKeyboardButton(text="Copy Password 🔑", callback_data=f"f_cp:{pwd}"))
    
    msg_task = await message.answer(text, reply_markup=kb.as_markup(), parse_mode="HTML")

    # Background auto-cancel (15 mins)
    await asyncio.sleep(900)
    db.execute("SELECT status FROM tasks WHERE gmail=? AND status='in_progress'", (gmail,))
    if db.fetchone():
        db.execute("DELETE FROM tasks WHERE gmail=? AND uid=?", (gmail, uid))
        db.execute("UPDATE stock SET status='available' WHERE sid=?", (sid,))
        conn.commit()
        try: await msg_task.delete()
        except: pass
        await bot.send_message(uid, "⏰ <b>time out task Chanel</b>")

