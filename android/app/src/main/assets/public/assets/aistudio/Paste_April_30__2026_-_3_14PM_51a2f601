@dp.message(CommandStart())
async def start_handler(message: Message, state: FSMContext):
    await state.clear()
    uid = message.from_user.id
    
    db.execute("SELECT banned FROM users WHERE uid=?", (uid,))
    b_check = db.fetchone()
    if b_check and b_check[0] == 1:
        await message.answer("❌ <b>Your account is banned!</b>", parse_mode="HTML")
        return

    if not await is_subscribed(uid):
        kb = InlineKeyboardBuilder()
        kb.row(InlineKeyboardButton(text="📢 Join Official Channel", url=CHANNEL_LINK))
        kb.row(InlineKeyboardButton(text="🔄 Verify Membership", callback_data="v_sub"))
        await message.answer("👋 <b>Welcome!</b>\n\nYou must join our official channel to use this bot.", reply_markup=kb.as_markup(), parse_mode="HTML")
        return

    db.execute("SELECT uid FROM users WHERE uid=?", (uid,))
    if not db.fetchone():
        args = message.text.split()
        ref_by = int(args[1]) if len(args) > 1 and args[1].isdigit() else None
        db.execute("INSERT INTO users (uid, ref_by, joined_date) VALUES (?, ?, ?)", (uid, ref_by, str(datetime.datetime.now(karachi_tz).strftime("%d/%m/%Y"))))
        conn.commit()

    if is_admin(uid):
        await message.answer("🛠️ <b>ADMIN PANEL LOADED</b>", reply_markup=get_admin_menu(), parse_mode="HTML")
    else:
        await message.answer("👋 <b>Welcome to Gmail Ultra Pro Bot!</b>", reply_markup=get_user_menu(), parse_mode="HTML")

@dp.callback_query(F.data == "v_sub")
async def verify_sub_cb(call: CallbackQuery, state: FSMContext):
    if await is_subscribed(call.from_user.id):
        await call.message.delete()
        await start_handler(call.message, state)
    else:
        await call.answer("❌ Join the channel first!", show_alert=True)

