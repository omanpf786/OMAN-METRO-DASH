@dp.message(F.text == "💰 Balance")
async def balance_checker(message: Message, state: FSMContext):
    """بیلنس چیک کرنے کا فنکشن (FIXED: DYNAMIC HOLD)"""
    await state.clear()
    uid = message.from_user.id
    if not await is_subscribed(uid):
        await message.answer("⚠️ Join our channel first!", reply_markup=get_sub_kb())
        return

    if await is_banned(uid): return
    
    db.execute("SELECT balance FROM users WHERE uid=?", (uid,))
    res = db.fetchone()
    bal = res[0] if res else 0.0
    
    # یہاں سے تبدیلی شروع (Hold Calculation)
    rew = float(get_conf('reward'))
    db.execute("SELECT COUNT(*) FROM tasks WHERE uid=? AND status='pending'", (uid,))
    pending_count = db.fetchone()[0]
    hld = pending_count * rew
    
    msg = (
        "💳 <b>YOUR WALLET STATUS</b>\n"
        "━━━━━━━━━━━━━━━━━━\n"
        f"💰 Available Balance: <b>${bal:.2f}</b>\n"
        f"⏳ Pending Clearance: <b>${hld:.2f}</b>\n"
        "━━━━━━━━━━━━━━━━━━\n"
        "<i>Tasks usually take 24h to move from Hold to Balance.</i>"
    )
    await message.answer(msg, parse_mode="HTML")

