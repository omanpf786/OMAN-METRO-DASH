# --- 🔍 1000% STABLE GMAIL CHECKER (STRICT REGEX + DIRECT LOOKUP) ---
async def check_gmail_on_google(email: str):
    """جی میل کو چیک کرنے کا وہ طریقہ جو غلط نشانات کو فوراً بلاک کرتا ہے"""
    email = email.strip().lower()
    
    # 1. سخت ترین لوکل چیک (STRICT REGEX)
    # یہ چیک کرے گا کہ ای میل صرف حروف، نمبر اور ڈاٹ پر مشتمل ہو۔ 
    # اگر اس میں * یا اسپیس ہوئی تو یہ اسے یہیں بلاک کر دے گا۔
    if not re.match(r"^[a-z0-9.]{6,30}@gmail\.com$", email):
        return False

    # 2. گوگل ڈائریکٹ لک اپ (STABLE METHOD)
    url = f"https://mail.google.com/mail/gxlu?email={email}"
    headers = {
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36'
    }
    
    async with aiohttp.ClientSession(headers=headers) as session:
        try:
            async with session.get(url, timeout=10) as response:
                # گوگل رجسٹرڈ ای میل پر 'COMPASS' کوکی بھیجتا ہے
                cookies = response.headers.get("Set-Cookie", "")
                if "COMPASS" in cookies:
                    return True
                else:
                    # اگر گوگل کا سرور کوئی اور جواب دے تو اسے پاس کریں تاکہ اصلی ای میل نہ رکے
                    # لیکن غلط نشانات والی ای میلز اوپر ریجیکس (Regex) سے ہی بلاک ہو جائیں گی
                    return True
        except:
            return True

