            await message.answer(f"❌ <b>Invalid Amount!</b>\nMin: ${min_w} | Max: ${bal}")
            return
            
        data = await state.get_data()
        fee = round(amount * 0.0333, 4)
        net = round(amount - fee, 4)
        
        # ڈیٹا بیس انٹری
        db.execute("INSERT INTO withdraws (uid, address, amount, fee, net, timestamp) VALUES (?, ?, ?, ?, ?, ?)", 
                   (message.from_user.id, data['wd_addr'], amount, fee, net, str(datetime.datetime.now())))
        conn.commit()
        
        confirmation = (
            "✅ <b>Withdrawal Request Sent!</b>\n\n"
            "💳 Method: USDT (BEP-20)\n"
            f"👛 Wallet: <code>{data['wd_addr']}</code>\n"
            f"💵 Debit amount: ${amount:.4f}\n"
            f"📉 Fee: ${fee:.4f}\n"
            f"💰 You will receive: ${net:.4f}\n\n"
            "<i>Status: Pending Admin Approval.</i>"
        )
        await message.answer(confirmation, parse_mode="HTML")
        await bot.send_message(OWNER_ID, f"🔔 <b>NEW WITHDRAWAL!</b>\nUser: <code>{message.from_user.id}</code>\nAmount: ${amount}")
        await state.clear()
        
    except ValueError:
        await message.answer("❌ Please enter a numeric value only.")

